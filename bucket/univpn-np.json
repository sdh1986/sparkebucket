{
    "version": "10781.20.0.0727",
    "description": "UniVPN Client 远程接入终端方案",
    "homepage": "https://www.leagsoft.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.leagsoft.com/doc/article/103107.html"
    },
    "url": "https://download.leagsoft.com/download/UniVPN/win/univpn-win-full-10781.20.0.0727-signed.zip",
    "hash": "35079d9eead0557fa8b954ec7ac47be8e4e70d69e8daadbd726b1db8e3788d61",
    "installer": {
        "script": [
            "$exe = (Get-ChildItem -Path \"$dir\" -Filter '*.exe' -Recurse | Select-Object -First 1).FullName",
            "$env:__UNIVPN_SETUP = $exe",
            "$body = 'Start-Process -FilePath $env:__UNIVPN_SETUP -ArgumentList ''/S'' -Wait | Out-Null'",
            "if (is_admin) { Invoke-Expression $body } else {",
            "    Write-Host 'Requesting administrator privileges for UniVPN installation...' -ForegroundColor Yellow",
            "    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($body))",
            "    Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand',$enc -Wait",
            "}",
            "Remove-Item Env:__UNIVPN_SETUP -ErrorAction SilentlyContinue",
            "if (!(Test-Path 'C:\\Program Files (x86)\\UniVPN')) { abort 'UniVPN installation failed or was cancelled.' }"
        ]
    },
    "uninstaller": {
        "script": [
            "$body = @'",
            "$tapAdapters = Get-PnpDevice -Class Net -FriendlyName 'TAP-Windows Adapter V9' -ErrorAction SilentlyContinue",
            "if ($tapAdapters) {",
            "    Write-Host 'Found TAP-Windows Adapter V9. Attempting to uninstall...'",
            "    foreach ($adapter in $tapAdapters) {",
            "        $instanceId = $adapter.InstanceID",
            "        Write-Host \"Uninstalling device with Instance ID: $instanceId\"",
            "        Start-Process -Wait -NoNewWindow -FilePath 'pnputil.exe' -ArgumentList ('/remove-device \"{0}\"' -f $instanceId) | Out-Null",
            "    }",
            "} else {",
            "    Write-Host 'TAP-Windows Adapter V9 not found.' -ForegroundColor Yellow",
            "}",
            "$uninstallerPath = \"C:\\Program Files (x86)\\UniVPN\\uninst.exe\"",
            "if (Test-Path $uninstallerPath) {",
            "    Write-Host 'Running UniVPN uninstaller from default path...'",
            "    Start-Process -Wait -NoNewWindow -FilePath $uninstallerPath -ArgumentList '/S' | Out-Null",
            "} else {",
            "    Write-Host \"UniVPN uninstaller also not found at default path: '$uninstallerPath'\" -ForegroundColor Red",
            "}",
            "'@",
            "if (is_admin) { Invoke-Expression $body } else {",
            "    Write-Host 'Requesting administrator privileges for UniVPN uninstallation...' -ForegroundColor Yellow",
            "    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($body))",
            "    Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand',$enc -Wait",
            "}"
        ]
    },
    "checkver": {
        "url": "https://www.leagsoft.com/doc/article/103107.html",
        "regex": "univpn-win-full-([\\d.]+)-signed\\.zip"
    },
    "autoupdate": {
        "url": "https://download.leagsoft.com/download/UniVPN/win/univpn-win-full-$version-signed.zip"
    }
}
